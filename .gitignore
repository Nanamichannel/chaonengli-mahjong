.godot/
/android/
*.translation

# 构建产物（exe / pck / 发布目录）
build/
*.exe
*.pck

# 服务器运行时数据
server/data/
__pycache__/
*.pyc
server/logs/
*.log

# 历史备份文件
*.swbak
*.pre_rules.bak
*.clickbak
*.bak

# 本机联机配置（含内网地址，别公开）
net.cfg

# 本地测试配置：这个文件只要存在，客户端就会跳过菜单直接进牌桌
test_seats.cfg

# 截图（导出预设已经排除，git 里也不用留）
screenshots/

# 临时文件
*.tmp
/_*.png
server/_tl.txt

# 部署包 / 服务器口令（千万别传）
tianma-server.tar.gz
net.cfg
net.cfg.*
server/net_config.json

# 本地调试开关：announce=1 时 F5 直接进和牌播报调界面
autoplay.cfg
server/mahjong.db

# 参考素材（每张卡的示范截图，80MB / 5000+ 文件，不进仓库）
Cailiao/UI/示范/

# 联机口令（导出时打进 exe，绝不进仓库）
net_token.cfg
net_token.txt

# 海底捞月帧序列（约 2.0 GB / 4730 个文件，Godot 里也有 .gdignore，只留在本地与打包里，不进仓库）
Cailiao/UI/海底捞月/

